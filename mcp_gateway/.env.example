# ======================================================================
# mcp_gateway — environment (copy to .env and fill in)
# ======================================================================

# Cube REST API the gateway talks to.
#   local docker-compose: http://cube:4000   |   sidecar: http://localhost:4000
CUBE_URL=http://localhost:4000

# Same secret as Cube (CUBEJS_API_SECRET). The gateway mints a JWT signed with it,
# which Cube verifies in non-dev mode; check_auth maps it to area=admin (RLS inert).
CUBE_API_SECRET=replace-with-the-same-cube-secret

# Token the AI agent must send to the gateway (Authorization). Leave empty to disable
# auth locally; set it in any shared/deployed environment.
GATEWAY_TOKEN=

# Server bind + query timeout (seconds; covers Cube's async "Continue wait").
MCP_HOST=0.0.0.0
MCP_PORT=8000
CUBE_QUERY_TIMEOUT=180
