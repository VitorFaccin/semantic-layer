# ======================================================================
# semantic-layer — environment variables (copy to .env and fill in)
#   cp .env.example .env && docker compose up --build
# ======================================================================

# --- General ---------------------------------------------------------
# Dev mode IGNORES access policies, so every RBAC assertion would pass vacuously.
# docker-compose forces it to false; keep it false here too unless you know why.
CUBEJS_DEV_MODE=false
CUBEJS_API_SECRET=replace-with-a-strong-secret
CUBEJS_LOG_LEVEL=info

# --- Access control (RBAC: level + domains) — see docs/access-control.md ---
# Fallback applied to an empty/legacy token (refresh worker, local tests):
#   true  -> resolve to ADMIN (convenient locally)
#   false -> least privilege (level 0, no domains)
CUBE_DEFAULT_ADMIN=true
# Secret signing the AGENT's JWT presented to the MCP gateway. The gateway validates it and
# forwards the claims (level/domains/is_admin) to Cube. Defaults to CUBEJS_API_SECRET when unset.
AGENT_JWT_SECRET=replace-with-a-strong-secret

# --- Warehouse -------------------------------------------------------
# Default: the local DuckDB file the `seed` compose service builds. No cloud, no credentials.
# To retarget, set the block below for your engine AND set WAREHOUSE in model/globals.py.
CUBEJS_DB_TYPE=duckdb
CUBEJS_DB_DUCKDB_DATABASE_PATH=/cube/warehouse/meridian.duckdb

# --- Pre-aggregations (cache) ----------------------------------------
# Three rollups are declared on the private cubes. WITHOUT the refresh worker they are never
# materialised, and a query matching one FAILS with "no pre-aggregation partitions were built
# yet" — the rollup being visible in the generated SQL only proves routing, not materialisation.
CUBEJS_REFRESH_WORKER=true
CUBEJS_PRE_AGGREGATIONS_SCHEMA=meridian_cache

# --- Cube Store (embedded in the all-in-one image) --------------------
CUBEJS_CUBESTORE_HOST=cubestore
CUBEJS_CUBESTORE_PORT=3030

# --- SQL API (Postgres protocol, used by BI clients) ------------------
CUBEJS_PG_SQL_PORT=15432
