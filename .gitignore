# Generated seed data — regenerate with `python warehouse/seed/generate.py`.
# The SCHEMA is versioned (warehouse/ddl, warehouse/schema.json): it is an interface and
# belongs in diffs. The 8 MB of CSV it fills is bulk output, and is not.
warehouse/seed/data/
warehouse/*.duckdb
warehouse/*.duckdb.wal
